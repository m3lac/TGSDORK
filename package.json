{
  "name": "tgsdork",
  "version": "1.0.0",
  "description": "Tugas & Academic Google Dorking AI Assistant",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tgsdork": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:ui": "TGSDORK_DEV_UI=1 tsx watch src/index.ts serve --port 3456",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/core/test_phase1.ts && tsx src/dorker/test_phase2.ts && tsx src/dorker/test_browser.ts && tsx src/test_e2e.ts"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "cheerio": "^1.0.0",
    "commander": "^13.1.0",
    "docx": "^9.2.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "unpdf": "^1.9.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/ws": "^8.18.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
